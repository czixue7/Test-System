{
  "name": "Answer_Test",
  "version": "0.4.4",
  "description": "答题测试库",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:debug": "tauri dev -- --debug",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build -- --debug",
    "tauri:android": "tauri android",
    "tauri:android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "parse-pdf": "tsx scripts/parse-pdf.ts",
    "test:grading": "tsx scripts/verify-grading.ts",
    "test:security": "tsx scripts/verify-markdown-safety.tsx",
    "test:utils": "tsx scripts/verify-utils.ts",
    "test:updater-duty": "tsx scripts/verify-updater-duty.ts",
    "test:ai-profiles": "tsx scripts/verify-ai-profiles.ts",
    "test:data-source": "tsx scripts/verify-data-source.ts",
    "test:multi-source": "tsx scripts/verify-multi-source.ts",
    "test:package-updates": "tsx scripts/verify-package-updates.ts",
    "test:bank-sync": "tsx scripts/verify-bank-sync.ts",
    "test:manual-sync": "tsx scripts/verify-manual-sync.ts",
    "test:manual-resources": "tsx scripts/verify-manual-resource-requests.ts",
    "test:bank-versions": "tsx scripts/verify-bank-versions.ts",
    "update:bank-index": "node scripts/update-bank-index.cjs",
    "service:dev": "npm --prefix question-bank-service run tauri:dev",
    "service:build": "npm --prefix question-bank-service run tauri:build",
    "test": "npm run typecheck && npm run test:grading && npm run test:security && npm run test:utils && npm run test:updater-duty && npm run test:ai-profiles && npm run test:data-source && npm run test:multi-source && npm run test:package-updates && npm run test:bank-sync && npm run test:manual-sync && npm run test:manual-resources && npm run test:bank-versions && npm run test:debug && npm run test:ui-release",
    "typecheck": "tsc --noEmit",
    "test:debug": "node --import tsx scripts/verify-debug-console.ts && node --import tsx scripts/verify-debug-features.ts",
    "test:ui-release": "node --import tsx scripts/verify-ui-release.tsx"
  },
  "dependencies": {
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-store": "^2.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.26.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "string-similarity": "^4.0.4",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/string-similarity": "^4.0.2",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "canvas": "^3.2.1",
    "exceljs": "^4.4.0",
    "pdf-parse": "^1.1.1",
    "pdf2pic": "^3.2.0",
    "pdfjs-dist": "^5.5.207",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5",
    "vconsole": "^3.15.1",
    "vite": "^5.3.1"
  },
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af"
}
