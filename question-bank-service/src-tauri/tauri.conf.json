{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "题库服务台",
  "version": "0.1.4",
  "identifier": "com.exam.question-bank-service",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1430", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "label": "main", "title": "题库服务台", "width": 1220, "height": 820, "minWidth": 940, "minHeight": 640 }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:" } },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["../../src-tauri/icons/icon.ico"], "windows": { "nsis": { "installMode": "currentUser", "languages": ["SimpChinese"] } } }
}
